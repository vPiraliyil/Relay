# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Producer
PORT=3000
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Worker
WORKER_ID=worker-1           # override per container in docker-compose
WORKER_CONCURRENCY=1
JOB_LOCK_TTL_MS=30000        # 30 seconds
MAX_ATTEMPTS=3

# Reaper
REAPER_INTERVAL_MS=5000      # scan every 5 seconds

# Dashboard
VITE_API_BASE_URL=http://localhost:3000
